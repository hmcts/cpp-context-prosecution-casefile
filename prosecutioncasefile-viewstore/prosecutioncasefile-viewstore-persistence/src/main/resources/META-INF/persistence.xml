<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd" version="3.0">

    <persistence-unit name="prosecutioncasefile-persistence-unit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <jta-data-source>java:/DS.prosecutioncasefile</jta-data-source>

        <properties>
            <!-- SJP prosecutions legitimately share OffenceDetails entities across defendants.
                 Hibernate 6 strict merge validation must be relaxed for this persistence unit. -->
            <property name="hibernate.event.merge.entity_copy_observer" value="allow"/>
        </properties>

    </persistence-unit>
</persistence>