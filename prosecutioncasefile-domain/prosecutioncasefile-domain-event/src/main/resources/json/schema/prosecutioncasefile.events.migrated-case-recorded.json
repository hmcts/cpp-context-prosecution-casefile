{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://moj.gov.uk/cps/prosecutioncasefile/domain/event/migrated-case-recorded.json",
  "type": "object",
  "properties": {
    "caseId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "prosecutionCaseReference": {
      "type": "string"
    },
    "migrationSourceSystemName": {
      "type": "string"
    },
    "migrationSourceSystemCaseIdentifier": {
      "type": "string"
    },
    "defendants": {
      "type": "array",
      "items": {
        "$ref": "http://cpp.moj.gov.uk/prosecution/casefile/json/schemas/migrated-case-defendant.json"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "caseId",
    "prosecutionCaseReference",
    "migrationSourceSystemName",
    "defendants"
  ]
}
